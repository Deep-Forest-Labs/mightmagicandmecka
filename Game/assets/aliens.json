 "bake": {
  "path": "MF.Bugs.bakeSheet(MFApp, unit, { cell, pitch, idle: true, frames: 8, attack: 4, shadow: false })",
  "only": true,
  "why": "Bugs bake into square cells centred on the body (meta.centered = true); the anchor is the ground point, identical in every frame. The helper also applies the bug finish (no hard outline). MFApp.buildSheet(bug, { cell: N }) is wrapped by js/bugs.js to call the helper; never use a raw foot-anchored fixed cell for bugs (it clips the body).",
  "engine": "Draw a frame at (x - meta.anchor.x, y - meta.anchor.y). Honour meta.centered and meta.anchor; do not assume feet at the cell bottom."
 },
